# dependencies
node_modules/
web/node_modules/

# build output
dist/
web/.next/
web/out/
*.tsbuildinfo

# test / coverage
coverage/

# secrets — 절대 커밋 금지
.env
.env.*
!.env.example

# 실거래 스냅샷·제어 플래그는 커밋하지 않음 (실데이터)
artifacts/live/*
!artifacts/live/.gitkeep

# 백테스트 산출물은 생성물 (소스 아님) — 커밋하지 않음
artifacts/backtests/*
!artifacts/backtests/.gitkeep

# 백테스트 데이터 캐시
.cache/
data-cache/

# OS / editor
.DS_Store
*.log
.vscode/
.idea/

# 튜닝 산출물도 생성물
artifacts/tuning/*
!artifacts/tuning/.gitkeep
